          "content": {
            "size": 2552,
            "mimeType": "application/json",
            "text": "[{\"messageIdentifier\":1040,\"name\":\"Known issues and Workarounds\",\"value\":\"<p><strong>(Last updated 02/23/26)</strong> Any known issues and workarounds for Patent Center can be found on the <a href=\\\"https://www.uspto.gov/patents/apply/patent-center\\\" target=\\\"_blank\\\" rel=\\\"noopener noreferrer\\\"><strong>Patent Center information page</strong>.</a></p>\",\"sequenceNumber\":35,\"severity\":\"null\",\"beginEffectiveDate\":\"2025-11-19T11:12:29\",\"createdDate\":\"2022-05-19T14:19:40.42\",\"activeIndicator\":true},{\"messageIdentifier\":4450,\"name\":\"Automated Interview Request (AIR) Form\",\"value\":\"<p><strong>Effective March 9, 2026, the Automated Interview Request (AIR) Form will be located in Patent Center. </strong>The request can be found under the Existing Submissions dropdown menu in Patent Center for Practitioners and Independent Inventors.</p>\",\"sequenceNumber\":28,\"severity\":\"1\",\"beginEffectiveDate\":\"2026-02-19T11:29:31\",\"createdDate\":\"2026-02-19T14:29:32.254859\",\"activeIndicator\":true},{\"messageIdentifier\":4554,\"name\":\"Practitioner Signature Announcement\",\"value\":\"<p>Please refer to <strong>Practitioner Signature Announcement </strong>located at Patent Center information page Alert section to obtain more information regarding the announcement.</p>\",\"sequenceNumber\":31,\"severity\":\"1\",\"beginEffectiveDate\":\"2026-04-14T00:00:00\",\"createdDate\":\"2026-04-14T13:51:30.87559\",\"activeIndicator\":true},{\"messageIdentifier\":4658,\"name\":\"1st Action Estimator\",\"value\":\"<p><strong>First Action Estimator</strong> is now available for applications in Patent Center. For more information, please click <a href=\\\"https://www.uspto.gov/patents/apply/patent-center#:~:text=Collapse%20all-,What%27s%20New,-Automated%20Interview%20Request\\\" target=\\\"_blank\\\" rel=\\\"noopener noreferrer\\\">here</a>.</p>\",\"sequenceNumber\":33,\"severity\":\"1\",\"beginEffectiveDate\":\"2026-05-12T13:35:30\",\"createdDate\":\"2026-05-12T13:35:30.327264\",\"activeIndicator\":true},{\"messageIdentifier\":4710,\"name\":\"Skip fee issue for support user\",\"value\":\"<p><strong>Practitioner support users remain on Review &amp; Submit page in follow-on submission.</strong> Practitioner support users who choose to “Skip fees for now” on the calculate fees page may be unable to further navigate or submit the follow-on submission. As a workaround, impacted users can navigate between pages by using the “Continue” or “Back” buttons instead.&nbsp;</p>\",\"sequenceNumber\":34,\"severity\":\"1\",\"beginEffectiveDate\":\"2026-06-18T17:59:48\",\"createdDate\":\"2026-06-18T17:59:48.974701\",\"activeIndicator\":true}]"
          },
